  "workflows": [
    {
      "id": "wf-order-processing",
      "workspaceId": "ws-prod-01",
      "name": "E-Commerce Order Processing Pipeline",
      "description": "End-to-end multi-step transaction workflow validating orders, reserving inventory, processing Stripe payments, issuing invoices, and delivering customer notifications.",
      "version": 3,
      "status": "ACTIVE",
      "slaTargetMs": 4500,
      "slaAvailabilityTarget": 99.95,
      "tags": [
        "e-commerce",
        "critical-revenue",
        "finance"
      ],
      "nodes": [
        {
          "id": "step-validate",
          "type": "validate_data",
          "name": "1. Validate Order",
          "description": "Validates customer ID, SKU format, and cart totals.",
          "dependencies": [],
          "timeoutMs": 3000,
          "maxRetries": 2,
          "retryBackoffMs": 500,
          "position": {
            "x": 80,
            "y": 160
          },
          "inputData": {
            "schemaVersion": "v2.1",
            "strictMode": true
          }
        },
        {
          "id": "step-inventory",
          "type": "inventory_check",
          "name": "2. Check Inventory",
          "description": "Reserves warehouse stock via SAP Inventory API.",
          "dependencies": [
            "step-validate"
          ],
          "timeoutMs": 4000,
          "maxRetries": 3,
          "retryBackoffMs": 1000,
          "dependencyService": "SAP Inventory Service",
          "position": {
            "x": 340,
            "y": 160
          }
        },
        {
          "id": "step-payment",
          "type": "payment_process",
          "name": "3. Process Payment",
          "description": "Charges payment gateway with idempotency key.",
          "dependencies": [
            "step-inventory"
          ],
          "timeoutMs": 5000,
          "maxRetries": 2,
          "retryBackoffMs": 2000,
          "dependencyService": "Stripe Payment Gateway",
          "position": {
            "x": 600,
            "y": 160
          },
          "inputData": {
            "gateway": "stripe",
            "currency": "USD",
            "capture": true
          }
        },
        {
          "id": "step-invoice",
          "type": "invoice_generate",
          "name": "4. Generate Invoice",
          "description": "Generates tax invoice and PDF via TaxJar / Billing API.",
          "dependencies": [
            "step-payment"
          ],
          "timeoutMs": 3500,
          "maxRetries": 2,
          "retryBackoffMs": 1000,
          "dependencyService": "Billing Invoice API",
          "position": {
            "x": 860,
            "y": 160
          }
        },
        {
          "id": "step-notification",
          "type": "notification",
          "name": "5. Send Order Confirmation",
          "description": "Sends email & push notification to customer.",
          "dependencies": [
            "step-invoice"
          ],
          "timeoutMs": 3000,
          "maxRetries": 3,
          "retryBackoffMs": 500,
          "isOptional": true,
          "dependencyService": "SendGrid Email API",
          "position": {
            "x": 1120,
            "y": 160
          }
        }
      ],
      "createdAt": "2026-10-13T05:26:47.184Z",
      "updatedAt": "2026-10-14T03:26:47.184Z"
    },
